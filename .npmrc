# Project-local npm settings.
# Every npm/pnpm cache, temp and header dir stays inside this folder.
# Relative paths here resolve against this file's directory.
cache=.dev-cache/npm
devdir=.dev-cache/node-gyp
store-dir=.dev-cache/pnpm-store

# Do not create lockfile-less noise / network churn in this project.
fund=false
audit=false
update-notifier=false
