{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shahroodazerov-stack/3D-IPAD-OS-JEWERLY/docs/evidence/schema.json",
  "title": "FacetForge phase evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase", "check", "result", "device", "os", "recorded_at", "artifacts", "notes"],
  "properties": {
    "phase": { "type": "integer", "minimum": 1, "maximum": 200 },
    "check": { "type": "string", "minLength": 10 },
    "result": { "enum": ["pass", "fail"] },
    "device": { "type": "string", "minLength": 3 },
    "os": { "type": "string", "minLength": 3 },
    "recorded_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "artifacts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "notes": { "type": "string" }
  }
}
